<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="20dp"
    android:paddingBottom="16dp"
    android:background="@color/app_bg">

    <!-- 顶部：标题 + 计时 + 失误 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/timerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="@color/ink_soft"
            android:textSize="15sp"
            android:fontFeatureSettings="tnum" />

        <TextView
            android:id="@+id/mistakesText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="@string/mistakes_fmt"
            android:textColor="@color/ink_soft"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- 棋盘 -->
    <com.kimiwork.sudoku.SudokuBoardView
        android:id="@+id/boardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp" />

    <TextView
        android:id="@+id/loadingText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/loading"
        android:textColor="@color/ink_soft"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- 功能键 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:weightSum="4">

        <Button
            android:id="@+id/btnUndo"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_control"
            android:text="↩ 撤销"
            android:textColor="@color/ink"
            android:textSize="13sp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnErase"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_control"
            android:text="⌫ 橡皮"
            android:textColor="@color/ink"
            android:textSize="13sp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnNotes"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_control"
            android:text="✎ 草稿"
            android:textColor="@color/ink"
            android:textSize="13sp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnAuto"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_control"
            android:text="⚡ 自动草稿"
            android:textColor="@color/ink"
            android:textSize="13sp"
            android:textAllCaps="false" />
    </LinearLayout>

    <!-- 数字键盘 1-9 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:weightSum="9">

        <Button android:id="@+id/btnPad1" style="@style/PadKey" />
        <Button android:id="@+id/btnPad2" style="@style/PadKey" />
        <Button android:id="@+id/btnPad3" style="@style/PadKey" />
        <Button android:id="@+id/btnPad4" style="@style/PadKey" />
        <Button android:id="@+id/btnPad5" style="@style/PadKey" />
        <Button android:id="@+id/btnPad6" style="@style/PadKey" />
        <Button android:id="@+id/btnPad7" style="@style/PadKey" />
        <Button android:id="@+id/btnPad8" style="@style/PadKey" />
        <Button android:id="@+id/btnPad9" style="@style/PadKey" android:layout_marginEnd="0dp" />
    </LinearLayout>

    <!-- 新一局 -->
    <Button
        android:id="@+id/btnNewGame"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_primary"
        android:text="@string/new_game"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textAllCaps="false" />
</LinearLayout>
